{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "torah-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// URL canonique : torah-mcp.com (domaine custom Cloudflare). L'adresse
	// torah-mcp.<compte>.workers.dev reste active en alias — des connecteurs
	// installés pointent dessus, ne pas la couper.
	"workers_dev": true,
	"routes": [
		{ "pattern": "torah-mcp.com", "custom_domain": true },
		{ "pattern": "www.torah-mcp.com", "custom_domain": true }
	],

	// Bundle du SKILL.md hebrewbooks en import texte
	"rules": [
		{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
	],

	// Journal statistique des questions du site (/question) — privé, sans IP.
	// Consultation : GET /stats (Basic auth, secret STATS_PASSWORD) ou
	// `npx wrangler d1 execute torah-mcp-stats --remote --command "..."`.
	"d1_databases": [
		{
			"binding": "STATS_DB",
			"database_name": "torah-mcp-stats",
			"database_id": "924948d9-b2fb-42d9-a375-7c811a678a22",
			"migrations_dir": "migrations"
		}
	],

	"vars": {
		"SERVER_NAME": "torah-mcp",
		"SERVER_VERSION": "1.9.0",
		"SEFARIA_API_URL": "https://www.sefaria.org/api"
	}

	// Secret optionnel :
	//   BEARER_TOKENS — liste de tokens séparés par des virgules. Absent = accès
	//   public (le serveur ne proxifie que des API publiques, sans clé).
	//   Le poser transforme le serveur en accès sur invitation :
	//   un token par ami, URL https://…workers.dev/<token>/mcp, révocation en
	//   retirant le token de la liste.
}
